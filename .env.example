# ============================================================
# KOTAK KREASI — Environment Variables Template
# Salin file ini menjadi .env dan isi dengan nilai yang benar
# ============================================================

# Google Service Account (dari Google Cloud Console)
GOOGLE_CLIENT_EMAIL=nama-service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="[REDACTED PRIVATE KEY]\n"

# ID folder Google Drive (dari URL folder)
# Contoh URL: https://drive.google.com/drive/folders/FOLDER_ID_DISINI
GOOGLE_DRIVE_FOLDER_ID=FOLDER_ID_DISINI

# ID Google Spreadsheet (dari URL spreadsheet)
# Contoh URL: https://docs.google.com/spreadsheets/d/SHEET_ID_DISINI/edit
GOOGLE_SHEETS_ID=SHEET_ID_DISINI

# PIN guru untuk membuka dashboard penilaian di /guru
GURU_PIN=1234