# ============================================================
# KOTAK KREASI — Environment Variables Template
# Copy this file to .env and fill in the real values.
# ============================================================

# Supabase project (Dashboard -> Settings -> API)
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=https://<PROJECT_REF>.supabase.co

# service_role key — SERVER ONLY. Never expose it to the browser and never
# commit this file. Routes use it to bypass RLS on the private `works` table.
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>

# Storage bucket holding the rendered pantun cards (private).
SUPABASE_BUCKET=works-images

# PIN for the teacher grading dashboard at /guru
GURU_PIN=<TEACHER_DASHBOARD_PIN>

# Local .env only — used by the CLI deploy steps, the app never reads it.
VERCEL_TOKEN=<VERCEL_TOKEN>
